# Production AI provider. LM Studio is local-only and intentionally unavailable on Vercel.
AI_PROVIDER=nvidia
AI_MAX_INPUT_CHARS=24000
NVIDIA_API_KEY=nvapi-YOUR_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Keep DEMO true until verified REAL standard records are connected to the retrieval stage.
DEMO_MODE=true

# Firebase Admin / Firestore. Preferred Vercel option: one compact service-account JSON value.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"bharatstandards-ai","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@...iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
FIREBASE_PROJECT_ID=bharatstandards-ai

# Firebase Hosting origins allowed to call this backend.
CORS_ORIGINS=https://bharatstandards-ai.web.app,https://bharatstandards-ai.firebaseapp.com
