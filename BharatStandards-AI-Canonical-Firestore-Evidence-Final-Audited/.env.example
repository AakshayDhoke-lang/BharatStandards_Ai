# ---------------- Frontend / Firebase Web App ----------------
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=bharatstandards-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bharatstandards-ai
VITE_FIREBASE_STORAGE_BUCKET=bharatstandards-ai.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# LOCAL frontend -> LOCAL FastAPI. In production create .env.production.local
# with your deployed Vercel backend URL, e.g. https://bharatstandards-api.vercel.app
VITE_API_BASE_URL=http://127.0.0.1:8000

VITE_DEMO_MODE=true

# ---------------- Local FastAPI backend ----------------
DEMO_MODE=true
AI_PROVIDER=lmstudio
AI_MAX_INPUT_CHARS=24000
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=auto

# NVIDIA remains available locally and is the production provider on Vercel.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Local Firebase Admin option. Do not commit service-account JSON.
FIREBASE_PROJECT_ID=bharatstandards-ai
FIREBASE_SERVICE_ACCOUNT_PATH=C:/path/to/firebase-adminsdk.json

# ---------------- Vercel backend environment variables ----------------
# Set these in Vercel Project Settings, NOT in the frontend build.
# AI_PROVIDER=nvidia
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# DEMO_MODE=true
# FIREBASE_PROJECT_ID=bharatstandards-ai
# FIREBASE_SERVICE_ACCOUNT_JSON={...service-account JSON...}
# CORS_ORIGINS=https://bharatstandards-ai.web.app,https://bharatstandards-ai.firebaseapp.com
